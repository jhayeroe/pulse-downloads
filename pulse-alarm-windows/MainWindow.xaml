<Window x:Class="PulseAlarm.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PULSE Alarm" Width="440" Height="760" MinWidth="390" MinHeight="620"
        WindowStartupLocation="CenterScreen" Background="#0E0F12" Foreground="White">
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/><RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Grid>
      <StackPanel>
        <TextBlock Text="PULSE" Foreground="{StaticResource PulseRedBrush}" FontSize="18" FontWeight="Bold"/>
        <TextBlock Text="ALARM" FontSize="34" FontWeight="Black"/>
      </StackPanel>
      <StackPanel HorizontalAlignment="Right">
        <TextBlock x:Name="ClockText" FontSize="28" FontWeight="Light" HorizontalAlignment="Right"/>
        <TextBlock x:Name="DateText" Foreground="#A7A9AF" HorizontalAlignment="Right"/>
      </StackPanel>
    </Grid>

    <Border Grid.Row="1" Margin="0,22,0,16" Padding="14" CornerRadius="14" Background="{StaticResource PanelBrush}">
      <DockPanel>
        <StackPanel DockPanel.Dock="Left">
          <TextBlock Text="MEETING MODE" FontWeight="Bold"/>
          <TextBlock Text="Alarm popups stay quiet" Foreground="#A7A9AF" FontSize="12"/>
        </StackPanel>
        <ToggleButton x:Name="MeetingToggle" DockPanel.Dock="Right" Width="54" Height="28"
                      Background="#303238" Foreground="White" Content="OFF"
                      Checked="MeetingToggle_OnChanged" Unchecked="MeetingToggle_OnChanged"/>
      </DockPanel>
    </Border>

    <ListBox x:Name="AlarmList" Grid.Row="2" Background="Transparent" BorderThickness="0"
             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <Border Background="{StaticResource PanelBrush}" CornerRadius="14" Padding="16" Margin="0,0,0,10">
            <Grid Width="350">
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="{Binding Title}" FontSize="17" FontWeight="Bold"/>
                <TextBlock Text="{Binding Details}" Foreground="#A7A9AF" TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding DueAt, StringFormat={}{0:ddd, MMM d • h:mm tt}}" Margin="0,8,0,0"
                           Foreground="{StaticResource PulseRedBrush}" FontWeight="SemiBold"/>
              </StackPanel>
              <Button Grid.Column="1" Content="DONE" Tag="{Binding}" Click="Done_Click"
                      Background="#2A2C31" Foreground="White" Margin="12,0,0,0"/>
            </Grid>
          </Border>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <Button Grid.Row="3" Content="＋  ADD ALARM" Height="54" Margin="0,14,0,0"
            Background="{StaticResource PulseRedBrush}" Foreground="White" FontSize="16"
            Click="AddAlarm_Click"/>
  </Grid>
</Window>
